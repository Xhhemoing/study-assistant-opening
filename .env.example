# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# Web
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://aistudy:aistudy@127.0.0.1:5432/aistudy
# Browser E2E resets only this isolated database. Its name must end in _e2e.
E2E_DATABASE_URL=postgres://aistudy:aistudy@127.0.0.1:5433/aistudy_e2e

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (MinIO by default)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=aistudy
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Auth / sessions (jose + revocable DB sessions)
AUTH_SECRET=dev-only-change-me-to-a-long-random-secret
# Set false only for plain-HTTP loopback/CI browser E2E. Production must use true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=aistudy_session

# Opening model: paid calls stay disabled until a positive daily cap and prices are set.
# Prices and caps use the same provider billing currency, in cents. Day boundary: UTC.
OPENING_MODEL_BASE_URL=https://api.openai.com/v1
OPENING_MODEL_API_KEY=
OPENING_MODEL_NAME=gpt-4o-mini
OPENING_MODEL_DAILY_CAP_CENTS=0
OPENING_MODEL_INPUT_CENTS_PER_MILLION=0
OPENING_MODEL_OUTPUT_CENTS_PER_MILLION=0

# Opening tutor runtime (worker). Must be finite positive integers.
OPENING_TUTOR_MAX_CONTEXT_CHARS=12000
OPENING_TUTOR_RESERVED_CENTS=100
OPENING_TUTOR_MAX_OUTPUT_TOKENS=2048

# Parser worker setup: see services/parser/README.md before starting the worker.
# Empty values select a repo-relative development venv: Windows Scripts/python.exe,
# Linux/macOS bin/python. CI and production must explicitly set both absolute paths.
PARSER_PYTHON=
PARSER_CWD=
# Optional absolute model-cache location; omitted means <repository>/.local/hf-home.
# HF_HOME=/srv/aistudy/hf-home
# Document conversion always enforces offline mode after the explicit setup step.
HF_HUB_OFFLINE=1

# Optional server-managed OpenAI-compatible model catalog (max 32).
# Omit to preserve OPENING_MODEL_* as model id "default" (legacy name gpt-4o-mini).
# [] disables the catalog. apiKeyEnv names a SERVER env var; never inline a real key.
# All models share OPENING_MODEL_DAILY_CAP_CENTS and the same billing currency.
# Keep ids stable; removing a selected id blocks that route until users select another.
# Apply identical configuration to web and worker, then restart both.
# When a workspace BYOK provider is already configured and available, merge prefers
# that workspace model over an env stub with missing_key (see docs/operations/opening-model-routing.md).
#
# Hermes / Tutor+vision example shape (placeholders only — put real key in secret store):
# OPENING_MODEL_CATALOG=[{"id":"lant-glm-5-3","label":"Lant GLM 5.3","providerId":"lant","providerLabel":"Lant","modelName":"glm-5.3","baseUrl":"https://your-lant-compatible-host.example/v1","apiKeyEnv":"LANT_API_KEY","inputCentsPerMillion":10,"outputCentsPerMillion":20,"supportsVision":true}]
# OPENING_MODEL_DEFAULT_ID=lant-glm-5-3
# OPENING_MODEL_DAILY_CAP_CENTS=1000
# LANT_API_KEY=
#
# Generic catalog example:
# OPENING_MODEL_CATALOG=[{"id":"fast","label":"日常模型","providerId":"primary","providerLabel":"主供应商","modelName":"your-model-name","baseUrl":"https://your-provider.example/v1","apiKeyEnv":"PRIMARY_MODEL_API_KEY","inputCentsPerMillion":10,"outputCentsPerMillion":20}]
# OPENING_MODEL_DEFAULT_ID=fast
# PRIMARY_MODEL_API_KEY=
# C01 connection credentials: base64 of exactly 32 random bytes; keep in the server/worker secret store.
# Also encrypts workspace-managed model provider keys (domain-separated AES-256-GCM).
# OPENING_CONNECTION_KEY=
# OPENING_CONNECTION_KEY_ID=primary
# Optional JSON object of base64 keys retained during rotation: {"old-key":"..."}
# OPENING_CONNECTION_PREVIOUS_KEYS={}
# Comma-separated administrator-approved IMAP hostnames. No arbitrary URL or private metadata host.
# OPENING_IMAP_ALLOWED_HOSTS=
