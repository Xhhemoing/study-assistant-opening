{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@playwright/test"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.opening.config.mts",
    "playwright.opening-restart.config.mts",
