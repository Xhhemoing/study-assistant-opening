    "bullmq": "5.56.10",
    "imapflow": "2.2.5",
    "ioredis": "5.6.1",
    "mailparser": "3.9.26"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.8.3",
