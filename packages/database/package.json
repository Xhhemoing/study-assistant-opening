{
  "name": "@aistudy/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aistudy/contracts": "0.0.0",
    "@aistudy/domain": "0.0.0",
    "@aws-sdk/client-s3": "3.832.0",
    "@aws-sdk/s3-request-presigner": "3.832.0",
    "drizzle-orm": "0.44.7",
    "postgres": "3.4.7"
  }
}
