{
  "name": "@aistudy/domain",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#cartridge-is-proxy": {
      "browser": "./src/opening/cartridges/is-proxy-unavailable.ts",
      "node": "./src/opening/cartridges/is-proxy-node.ts",
      "default": "./src/opening/cartridges/is-proxy-unavailable.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/portability/native/index.ts",
      "default": "./src/portability/native/index.ts"
    },
    "./cartridge-sdk-lite": {
      "types": "./src/cartridge-sdk-lite/index.ts",
      "default": "./src/cartridge-sdk-lite/index.ts"
    },
    "./opening/ai-policy": {
      "types": "./src/opening/ai-policy/index.ts",
      "default": "./src/opening/ai-policy/index.ts"
    },
    "./exam-sprint-catalog": {
      "types": "./src/opening/exam-sprint/catalog.ts",
      "default": "./src/opening/exam-sprint/catalog.ts"
    },
    "./measurement-catalog": {
      "types": "./src/opening/measurement/catalog.ts",
      "default": "./src/opening/measurement/catalog.ts"
    },
    "./span-heldout-catalog": {
      "types": "./src/opening/span-heldout-catalog.ts",
      "default": "./src/opening/span-heldout-catalog.ts"
    },
    "./material-course-package-adapter": {
      "types": "./src/opening/material-course-package-adapter.ts",
      "default": "./src/opening/material-course-package-adapter.ts"
    },
    "./material-source-locator": {
      "types": "./src/opening/material-source-locator.ts",
      "default": "./src/opening/material-source-locator.ts"
    },
    "./opening/cartridges": {
      "types": "./src/opening/cartridges/index.ts",
      "default": "./src/opening/cartridges/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aistudy/contracts": "0.0.0",
    "ts-fsrs": "5.4.2"
  }
}
