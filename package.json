{
  "name": "aistudy",
  "private": true,
  "version": "0.0.0",
  "description": "AIstudy lifelong learning platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aistudy/web",
    "worker:dev": "npm run dev -w @aistudy/worker",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w @aistudy/web",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "echo \"e2e not configured yet\" && exit 0",
    "build": "tsc -b --pretty false && npm run build -w @aistudy/web",
    "build:packages": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "22.15.32",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "4.1.10"
  }
}
