# GENERATED from packages/config/src/registry.ts. Do not edit by hand:
#   npx tsx scripts/env-examples.ts --write   (CI: --check)
# Compose/production template for infra/docker/compose.opening.yml.
# Copy to infra/docker/opening.env and replace every REPLACE_ME value.
# Server switches only; one image serves every environment (no build args).

# --- Runtime ---
# development | test | production. [enum]
NODE_ENV=production
# Public web origin; cookie-auth Origin checks use it. [url, required:always]
PUBLIC_BASE_URL=https://REPLACE_ME.example

# --- Compose infrastructure (docker template only; compose fails closed if unset) ---
# Compose Postgres user. [string]
OPENING_POSTGRES_USER=REPLACE_ME_pg_user
# Compose Postgres password. [string, secret]
OPENING_POSTGRES_PASSWORD=REPLACE_ME_pg_password_long_random
# Compose Postgres database. [string]
OPENING_POSTGRES_DB=aistudy_opening
# Loopback host port for Postgres. [int]
OPENING_POSTGRES_PORT=5432
# Compose Redis password. [string, secret]
OPENING_REDIS_PASSWORD=REPLACE_ME_redis_password_long_random
# Loopback host port for Redis. [int]
OPENING_REDIS_PORT=6379
# MinIO root user. [string, secret]
OPENING_S3_ACCESS_KEY_ID=REPLACE_ME_s3_access_key
# MinIO root password. [string, secret]
OPENING_S3_SECRET_ACCESS_KEY=REPLACE_ME_s3_secret_key_long_random
# Bucket created by compose. [string]
OPENING_S3_BUCKET=aistudy-opening
# Loopback host port for MinIO. [int]
OPENING_S3_PORT=9000
# Loopback host port for the MinIO console. [int]
OPENING_S3_CONSOLE_PORT=9001
# Loopback host port for web. [int]
OPENING_WEB_PORT=3000
# Optional env_file override (default ./opening.env next to compose). [string]
# OPENING_ENV_FILE=./opening.env

# --- PostgreSQL ---
# Application database. [string, secret, required:always]
DATABASE_URL=postgres://REPLACE_ME_pg_user:REPLACE_ME_pg_password_long_random@postgres:5432/aistudy_opening

# --- Redis / BullMQ ---
# Queue connection. [string, secret, required:always]
REDIS_URL=redis://:REPLACE_ME_redis_password_long_random@redis:6379

# --- S3-compatible object storage ---
# S3 endpoint (MinIO by default). [url, required:production]
S3_ENDPOINT=http://minio:9000
# Region. [string, required:production]
S3_REGION=us-east-1
# Bucket. [string, required:production]
S3_BUCKET=aistudy-opening
# Access key id. [string, secret, required:production]
S3_ACCESS_KEY_ID=REPLACE_ME_s3_access_key
# Secret access key. [string, secret, required:production]
S3_SECRET_ACCESS_KEY=REPLACE_ME_s3_secret_key_long_random
# Path-style addressing (true for MinIO). [bool]
S3_FORCE_PATH_STYLE=true
# Alias of S3_FORCE_PATH_STYLE (OPENING_S3_* preferred by restore CLI). [bool]
OPENING_S3_FORCE_PATH_STYLE=true

# --- Auth / sessions ---
# Session JWT secret, at least 32 characters. [string, secret, required:always]
AUTH_SECRET=REPLACE_ME_auth_secret_long_random
# false only for plain-HTTP loopback/CI E2E. Production must use true. [bool]
SESSION_COOKIE_SECURE=true
# Session lifetime, integer >= 60. [int]
SESSION_TTL_SECONDS=604800
# Session cookie name. [string]
AUTH_COOKIE_NAME=aistudy_session

# --- Opening release mode (server switch; the UI reads /api/opening/capabilities) ---
# 1 closes self-registration (server-enforced in /api/auth/register) and redirects legacy /learn, /explore, /preview. [bool]
OPENING_RELEASE=1

# --- Opening model (paid calls stay off until a positive daily cap and prices are set) ---
# OpenAI-compatible base URL. [url]
OPENING_MODEL_BASE_URL=https://api.openai.com/v1
# Model API key (secret store only). Key + positive cap requires positive prices. [string, secret]
OPENING_MODEL_API_KEY=
# Model name. [string]
OPENING_MODEL_NAME=gpt-4o-mini
# Daily cap in provider billing cents (UTC day). 0 disables paid calls. [int]
OPENING_MODEL_DAILY_CAP_CENTS=0
# Input price per million tokens. [string]
OPENING_MODEL_INPUT_CENTS_PER_MILLION=0
# Output price per million tokens. [string]
OPENING_MODEL_OUTPUT_CENTS_PER_MILLION=0

# --- Opening tutor runtime (worker) ---
# Finite positive integer. [int]
OPENING_TUTOR_MAX_CONTEXT_CHARS=12000
# Finite positive integer. [int]
OPENING_TUTOR_RESERVED_CENTS=100
# Finite positive integer. [int]
OPENING_TUTOR_MAX_OUTPUT_TOKENS=2048

# --- Parser worker ---
# Absolute parser venv python. Empty selects the repo-relative dev venv; CI/production must set it (see services/parser/README.md). [string]
# PARSER_PYTHON=/opt/parser-venv/bin/python
# Absolute parser working directory (same rule as PARSER_PYTHON). [string]
# PARSER_CWD=/opt/parser
# Parser scratch directory (default .tmp/opening-parser). [string]
# PARSER_TEMP_DIR=.tmp/opening-parser
# Document conversion enforces offline mode after setup. [bool]
HF_HUB_OFFLINE=1
# OCR readiness requires this directory. [string]
# PARSER_OCR_MODEL_DIR=
# Whisper model size. [string]
# OPENING_WHISPER_MODEL_SIZE=base
# Optional local Whisper model path. [string]
# OPENING_WHISPER_MODEL_PATH=

# --- Connections (credential vault, IMAP, DingTalk, Feishu) ---
# Base64 of exactly 32 random bytes; encrypts connection credentials and workspace model keys. Secret store only. [string, secret]
# OPENING_CONNECTION_KEY=
# Key id for OPENING_CONNECTION_KEY (requires it). [string]
# OPENING_CONNECTION_KEY_ID=primary
# JSON object of base64 keys kept during rotation (requires OPENING_CONNECTION_KEY). [json, secret]
# OPENING_CONNECTION_PREVIOUS_KEYS={}
# Comma-separated administrator-approved IMAP hostnames. [csv]
# OPENING_IMAP_ALLOWED_HOSTS=
# Comma-separated DingTalk attachment download hosts. Unset denies every attachment. [csv]
# OPENING_DINGTALK_ALLOWED_DOWNLOAD_HOSTS=
# DingTalk callback corp id (callback route needs all four DINGTALK_* callback values). [string]
# OPENING_DINGTALK_CORP_ID=
# DingTalk callback signing token. Secret store only. [string, secret]
# OPENING_DINGTALK_CALLBACK_TOKEN=
# DingTalk callback AES key. Secret store only. [string, secret]
# OPENING_DINGTALK_ENCODING_AES_KEY=
# JSON map of callback connections. [json]
# OPENING_DINGTALK_CALLBACK_CONNECTIONS={}
# Feishu reminder adapter credential. Secret store only. [string, secret]
# FEISHU_REMINDER_CREDENTIAL=

# --- AI teaching loop: server switches only (API enabled / UI shown / rollout). No NEXT_PUBLIC_* twins. ---
# API enabled: teaching-loop routes (commands/checkpoint/resume) answer only when 1; checked on every request. [bool]
# OPENING_TEACHING_LOOP=0
# UI shown: teaching workspace/loop UI. Requires OPENING_TEACHING_LOOP=1. [bool]
# OPENING_TEACHING_WORKSPACE=0
# Gradual rollout 0-100 by stable user bucket (default 100). Requires OPENING_TEACHING_LOOP=1 when set. [percent]
# OPENING_TEACHING_LOOP_ROLLOUT_PERCENT=100
# Worker: teaching compiler (default 0). [bool]
# OPENING_TEACHING_COMPILER_ENABLED=0
# Worker: post-publish validation (default 0). [bool]
# OPENING_TEACHING_VALIDATION_ENABLED=0
# Worker: append Markdown writing rules to tutor answers; 0 restores the previous prompt (default 1). [bool]
# OPENING_ANSWER_STYLE=1
# UI-only: matrix transform interactivity (default 1). Delivered via capabilities. [bool]
# OPENING_MATRIX_TRANSFORM_INTERACTIVE=1
# UI-only: jingwei 图解 under chat answers that already state a flow or numeric table (default 0). Delivered via capabilities. [bool]
# OPENING_CHAT_ARTIFACTS=0
# UI-only: render chat answers as Markdown with math; 0 falls back to plain text (default 1). Delivered via capabilities. [bool]
# OPENING_CHAT_PROSE=1

# --- Tests / E2E ---
# Local archive path for readiness backupFreshness probe. [string]
# OPENING_BACKUP_ARCHIVE_PATH=
# Max age hours for backup freshness (default 24). [int]
# OPENING_BACKUP_MAX_AGE_HOURS=24
