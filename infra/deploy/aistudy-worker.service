[Unit]
Description=AIstudy Worker (BullMQ consumer)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aistudy
EnvironmentFile=/opt/aistudy/.env.production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs apps/worker/src/index.ts
Restart=always
RestartSec=5
MemoryMax=1024M
MemoryHigh=896M
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aistudy

[Install]
WantedBy=multi-user.target
